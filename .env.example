# Copy to .env for local development: cp .env.example .env
# Every value here is a local-only default matching infra/docker-compose.yml.
# Never put real credentials in this file: it's committed.

# --- Backing services (infra/docker-compose.yml) ---
DATABASE_URL=postgres://lockstep:lockstep@127.0.0.1:5432/lockstep
REDIS_URL=redis://127.0.0.1:6379

# --- Ports ---
WEB_PORT=3000
SYNC_PORT=4444
SYNC_METRICS_PORT=9464

# --- Added as each component lands (documented here when introduced) ---
# M3  sync server limits:  SYNC_MAX_MESSAGE_BYTES, SYNC_MAX_DOC_BYTES, SYNC_RATE_PER_SEC, SYNC_RATE_BURST
# M5  auth:                GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, BETTER_AUTH_SECRET,
#                          ROOM_TOKEN_PRIVATE_KEY (web only), ROOM_TOKEN_PUBLIC_KEYS (sync)
# M3.5 errors:             SENTRY_DSN
