{
  "name": "lockstep",
  "private": true,
  "description": "A real-time collaborative code editor",
  "license": "MIT",
  "author": "Mmoloki Kgololosego",
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check:pipeline": "node --test scripts/*.test.mjs",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d --wait",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "verify": "node verify/src/cli.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@types/node": "^24.19.3",
    "@vitest/coverage-v8": "5.1.2",
    "turbo": "2.11.13",
    "typescript": "7.0.2",
    "vitest": "5.1.2"
  }
}
