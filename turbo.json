{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "outputs": []
    },
    "test": {
      "outputs": [],
      "env": ["CONVERGENCE_RUNS", "FUZZ_RUNS"]
    },
    "test:coverage": {
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test:property": {
      "outputs": [],
      "env": ["CONVERGENCE_RUNS"]
    },
    "test:fuzz": {
      "outputs": [],
      "env": ["FUZZ_RUNS"]
    },
    "test:integration": {
      "outputs": [],
      "cache": false,
      "env": ["DATABASE_URL", "REDIS_URL"]
    }
  }
}
